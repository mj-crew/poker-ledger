# Copy to .env and adjust. Local docker-compose Postgres uses port 5433.
DATABASE_URL=postgres://poker:poker@localhost:5433/poker_ledger
# Set true when the DB requires SSL (e.g. a hosted Postgres public URL). Railway's
# private DATABASE_URL does not need it; leave unset locally.
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma-separated origins allowed to call the API. Not needed in production when the
# backend serves the built front-end (same origin). Only for a split dev/host setup.
CORS_ORIGIN=http://localhost:5173
# Temp password given to the seeded admin (Michal) on first run. Change after login.
ADMIN_BOOTSTRAP_PASSWORD=changeme
# Screenshot reading (Phase 2). Needed for the "Upload screenshot" buttons.
ANTHROPIC_API_KEY=
# Optional: override the vision model (defaults to claude-opus-5).
VISION_MODEL=claude-opus-5
