{
  "name": "poker-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-cash ledger + live dashboard for the Flawless Poker Room home game",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node db/migrate.js --seed && node src/server.js",
    "build": "npm install --prefix web && npm run build --prefix web",
    "serve": "node src/server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/migrate.js --seed",
    "test": "node --test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/static": "^7.0.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
